<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Vigil {{ generated[:10] }}</title>
<style>
:root {
  --ink: #1a1d21;
  --muted: #5c6570;
  --line: #dde1e6;
  --paper: #ffffff;
  --page: #eef1f4;
  --action: #b42318;
  --action-soft: #fef3f2;
  --watch: #b54708;
  --watch-soft: #fffaeb;
  --ok: #067647;
  --link: #175cd3;
}
body {
  margin: 0;
  background: var(--page);
  color: var(--ink);
  font: 16px/1.5 "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
}
main { max-width: 920px; margin: 0 auto; padding: 28px 20px 56px; }
h1 { margin: 0; font-size: 30px; letter-spacing: -0.02em; font-weight: 700; }
h2 {
  margin: 36px 0 12px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}
h3 { margin: 0 0 10px; font-size: 18px; letter-spacing: -0.01em; }
a { color: var(--link); }
code {
  font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, monospace;
  font-size: 0.92em;
  background: #f2f4f7;
  padding: 0.1em 0.35em;
}
.banner {
  padding: 28px 20px 24px;
  color: #fff;
  background: #344054;
}
.banner-ok { background: #067647; }
.banner-action { background: #dc6803; }
.banner-degraded { background: #b42318; }
.banner-inner { max-width: 920px; margin: 0 auto; }
.banner .eyebrow {
  margin: 0 0 6px;
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.85;
  font-weight: 600;
}
.banner .state { margin: 0 0 14px; font-size: 22px; font-weight: 650; }
.banner .meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 18px;
  margin: 0;
  padding: 0;
  list-style: none;
  font-size: 15px;
}
.banner .meta li { margin: 0; }
.banner .meta .label { opacity: 0.8; margin-right: 0.35em; }
.banner .problems {
  margin: 16px 0 0;
  padding: 12px 14px;
  background: rgba(0, 0, 0, 0.18);
  border-radius: 6px;
}
.banner .problems summary {
  cursor: pointer;
  font-weight: 600;
}
.banner .problems ul { margin: 10px 0 0; padding-left: 18px; }
.panel {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 16px 18px 18px;
}
.priority {
  color: var(--muted);
  font-weight: 500;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-left: 8px;
}
.app-block {
  padding: 16px 0;
  border-top: 1px solid var(--line);
}
.app-block:first-child { border-top: 0; padding-top: 4px; }
.app-block h3 a { color: inherit; text-decoration: none; }
.app-block h3 a:hover { color: var(--link); }
.todo-list { list-style: none; margin: 0; padding: 0; }
.todo-list li {
  margin: 0 0 8px;
  padding: 10px 12px;
  border-radius: 6px;
  border-left: 3px solid transparent;
}
.todo-list li:last-child { margin-bottom: 0; }
.sev-action {
  color: var(--action);
  background: var(--action-soft);
  border-left-color: var(--action) !important;
  font-weight: 600;
}
.sev-watch {
  color: #7a2e0e;
  background: var(--watch-soft);
  border-left-color: #f79009 !important;
}
.sev-info { color: var(--ink); }
.badge {
  display: inline-block;
  min-width: 1.5em;
  padding: 0.1em 0.45em;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  text-align: center;
}
.badge-action { background: var(--action-soft); color: var(--action); }
.badge-watch { background: var(--watch-soft); color: var(--watch); }
.badge-zero { background: #f2f4f7; color: var(--muted); }
.summary-table { margin: 0; }
.summary-table th, .summary-table td { border-color: var(--line); }
.summary-table a { font-weight: 600; text-decoration: none; }
.summary-table a:hover { text-decoration: underline; }
.num { text-align: right; font-variant-numeric: tabular-nums; width: 5.5rem; }
table { width: 100%; border-collapse: collapse; background: var(--paper); border-radius: 8px; overflow: hidden; }
th, td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
th { background: #f8fafc; font-size: 13px; color: var(--muted); font-weight: 600; }
.outlier { background: #fff6d8; }
.quote {
  margin: 0 0 12px;
  padding: 12px 14px;
  background: #f8fafc;
  border-radius: 6px;
  border: 1px solid var(--line);
}
.quote:last-child { margin-bottom: 0; }
.suggestion { color: var(--muted); font-size: 14px; }
.fetch-failed, .fetch-unexpected { background: #fef3f2; }
.fetch-ok { background: var(--paper); }
.empty { color: var(--muted); margin: 0; }
.muted { color: var(--muted); }
.lead { margin: 0 0 14px; color: var(--muted); }
.section-note { margin: -4px 0 12px; color: var(--muted); font-size: 14px; }
details.proposals,
details.awareness {
  margin-top: 0;
}
details.proposals {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px 18px 14px;
}
details.awareness {
  margin-top: 14px;
  border-top: 1px solid var(--line);
  padding-top: 10px;
}
details.proposals > summary,
details.awareness > summary {
  cursor: pointer;
  list-style: none;
  color: var(--muted);
  font-weight: 650;
  padding: 4px 0;
}
details.proposals > summary {
  color: var(--ink);
  font-size: 15px;
}
details.proposals > summary::-webkit-details-marker,
details.awareness > summary::-webkit-details-marker { display: none; }
details.proposals > summary::before,
details.awareness > summary::before { content: "▸ "; }
details.proposals[open] > summary::before,
details.awareness[open] > summary::before { content: "▾ "; }
details.proposals .panel-body { margin-top: 12px; }
.footer {
  margin-top: 28px;
  color: var(--muted);
  font-size: 13px;
}
</style>
</head>
<body>
<header class="banner banner-{{ state }}">
  <div class="banner-inner">
    <p class="eyebrow">Vigil</p>
    <p class="state">{{ state_label }}</p>
    <ul class="meta">
      <li><span class="label">Actions</span>{{ action_count }}</li>
      <li><span class="label">Affecting proposals</span>{{ affects_apps|length }}</li>
      {% if worth_knowing %}
      <li><span class="label">Other proposals</span>{{ worth_knowing|length }}</li>
      {% endif %}
      <li><span class="label">Requirements verified</span>{{ last_verified }}</li>
    </ul>
    {% if errors %}
    <details class="problems" open>
      <summary>{{ errors|length }} source problem{% if errors|length != 1 %}s{% endif %}</summary>
      <ul>
        {% for error in errors %}
        <li>{{ error }}</li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}
  </div>
</header>
<main>
  {% if todo_groups %}
  <h2>By app</h2>
  <p class="section-note">Jump to an app’s to-do list. Actions first.</p>
  <table class="summary-table">
    <thead>
      <tr>
        <th>App</th>
        <th class="num">Actions</th>
        <th class="num">Watches</th>
      </tr>
    </thead>
    <tbody>
      {% for group in todo_groups %}
      <tr>
        <td><a href="#{{ group.anchor }}">{{ group.name }}</a></td>
        <td class="num">
          <span class="badge {% if group.action_count %}badge-action{% else %}badge-zero{% endif %}">{{ group.action_count }}</span>
        </td>
        <td class="num">
          <span class="badge {% if group.watch_count %}badge-watch{% else %}badge-zero{% endif %}">{{ group.watch_count }}</span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h2>To-do</h2>
  <div class="panel">
    {% if todo_groups %}
      {% for group in todo_groups %}
      <section class="app-block" id="{{ group.anchor }}">
        <h3>
          <a href="#{{ group.anchor }}">{{ group.name }}</a>
          <span class="priority">{{ group.priority }}</span>
        </h3>
        <ul class="todo-list">
          {% for line in group.lines %}
          <li class="sev-{{ line.severity }}">{{ line.text or line.message }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    {% else %}
      <p class="empty">No action or watch items.</p>
    {% endif %}
  </div>

  <h2>Drift</h2>
  {% if drift.rows %}
  <table>
    <thead>
      <tr>
        <th>App</th>
        {% for column in drift.columns %}
        <th>{{ column }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in drift.rows %}
      <tr>
        <td>{{ row.name }}</td>
        {% for cell in row.cells %}
        <td class="{% if cell.outlier %}outlier{% endif %}">{{ cell.text }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">No repos scanned.</p>
  {% endif %}

  <h2>Package health</h2>
  <div class="panel">
    {% if packages %}
    <ul class="todo-list">
      {% for line in packages %}
      <li class="sev-{{ line.severity }}">{{ line.message }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty">No discontinued, retracted, or outdated direct packages recorded.</p>
    {% endif %}
  </div>

  <h2>Expiries</h2>
  <div class="panel">
    {% if expiries %}
    <ul class="todo-list">
      {% for line in expiries %}
      <li class="sev-{{ line.severity }}">{{ line.message }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty">No expiries listed.</p>
    {% endif %}
  </div>

  <h2>Pending proposals</h2>
  <p class="section-note">Optional. Store consoles often cover the same news. Expand only if you want to update <code>requirements.yaml</code> via <code>vigil review</code>.</p>
  <details class="proposals">
    <summary>
      {% if affects_apps or worth_knowing %}
      {{ affects_apps|length }} affecting{% if worth_knowing %}, {{ worth_knowing|length }} other{% endif %} — collapsed
      {% else %}
      No proposals waiting
      {% endif %}
    </summary>
    <div class="panel-body">
      {% if affects_apps or worth_knowing %}
        {% if affects_apps %}
        <p class="lead">{{ affects_apps|length }} that affect your apps. Run <code>vigil review</code>.</p>
        {% for proposal in affects_apps %}
        <p class="quote">
          <a href="{{ proposal.snippet_url }}">{{ proposal.source_id }}</a><br>
          {{ proposal.quote }}
          <br><span class="suggestion">suggested: {{ proposal.suggested_field }} = {{ proposal.suggested_value }}</span>
        </p>
        {% endfor %}
        {% else %}
        <p class="empty">No proposals that change a store or SDK requirement.</p>
        {% endif %}
        {% if worth_knowing %}
        <details class="awareness">
          <summary>{{ worth_knowing|length }} other proposal{% if worth_knowing|length != 1 %}s{% endif %} worth knowing</summary>
          {% for proposal in worth_knowing %}
          <p class="quote">
            <a href="{{ proposal.snippet_url }}">{{ proposal.source_id }}</a><br>
            {{ proposal.quote }}
            {% if proposal.suggested_field %}
            <br><span class="suggestion">suggested: {{ proposal.suggested_field }}{% if proposal.suggested_value %} = {{ proposal.suggested_value }}{% endif %}</span>
            {% endif %}
          </p>
          {% endfor %}
        </details>
        {% endif %}
      {% else %}
        <p class="empty">No proposals waiting.</p>
      {% endif %}
    </div>
  </details>

  <h2>Source fetch log</h2>
  <table>
    <thead>
      <tr><th>Source</th><th>Status</th><th>Detail</th></tr>
    </thead>
    <tbody>
      {% for row in fetches %}
      <tr class="fetch-{{ row.status }}">
        <td>{{ row.name }}</td>
        <td>{{ row.status }}</td>
        <td>{{ row.detail }}</td>
      </tr>
      {% else %}
      <tr><td colspan="3">No sources configured.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="footer">Generated {{ generated }}. Dependabot and Sentry are not queried.</p>
</main>
</body>
</html>
